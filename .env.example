# =============================================================================
# HelpTravel — przykładowy plik środowiskowy
# Skopiuj ten plik jako `.env.local` i wypełnij wartości do pracy lokalnej.
# Na Vercelu: Project Settings → Environment Variables → dodaj każdą osobno.
# =============================================================================

# --- Podstawowe ---------------------------------------------------------------
DATABASE_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# --- Panel admina (/admin/*) --------------------------------------------------
# Basic Auth na całym /admin/*. Bez tych dwóch zmiennych panel będzie zablokowany.
ADMIN_USER=""
ADMIN_PASSWORD=""

# --- Rate limiting (Upstash Redis) -------------------------------------------
# Klucze z https://console.upstash.com/. Jeśli puste, rate limiting WYŁĄCZONY.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Integracje publiczne ----------------------------------------------------
PEXELS_API_KEY=""
GEOAPIFY_API_KEY=""

# --- Domyślny punkt wylotu (UI fallback) -------------------------------------
NEXT_PUBLIC_DEFAULT_ORIGIN_IATA="WAW"
NEXT_PUBLIC_DEFAULT_ORIGIN_CITY="Warszawa"

# --- LiteAPI (HOTELS — sandbox + production) ---------------------------------
# Single host for both environments per LiteAPI docs. The `sand_` vs `prod_`
# key prefix selects the environment — there is NO `api.sandbox.liteapi.travel`.
# Reference: https://docs.liteapi.travel/reference/authentication
LITEAPI_BASE_URL="https://api.liteapi.travel/v3.0"
LITEAPI_BOOK_BASE_URL="https://book.liteapi.travel/v3.0"

# Sandbox: wymagane do uruchomienia /api/stays/search bez kluczy produkcyjnych.
LITEAPI_SANDBOX_KEY=""
LITEAPI_SANDBOX_PRIVATE_KEY=""
# Production — booking flow.
# LITEAPI_PROD_PRIVATE_KEY = standardowy klucz "Private API Key" (prefix prod_),
# używany w nagłówku X-API-Key dla WSZYSTKICH wywołań: search, rates ORAZ
# booking (prebook/book). Zweryfikowane live (BOOKING_AUDIT.md §2/§8).
LITEAPI_PROD_KEY=""
LITEAPI_PROD_PRIVATE_KEY=""
# UWAGA: LITEAPI_PROD_PUBLIC_KEY (prefix prod_, dłuższy) to klucz HMAC /
# publishable dla widgetu płatności. NIE wolno go wysyłać w X-API-Key (zwraca
# 401 — patrz src/lib/liteapi/client.ts). Alias NEXT_PUBLIC_LITEAPI_PROD_PUBLIC_KEY
# (dla przeglądarki) dodamy dopiero w Phase 3 (widget). Na razie zostaw pusty.
LITEAPI_PROD_PUBLIC_KEY=""
# Phase 3 — widget publishable key, EXPOSED TO THE BROWSER. Set this to the
# SAME value as LITEAPI_PROD_PUBLIC_KEY (LiteAPI's "Public Key", prefix prod_).
# The Payment SDK sends it to payment-wrapper.liteapi.travel/config; it is
# NEVER used in X-API-Key. Required (browser) for the booking widget.
NEXT_PUBLIC_LITEAPI_PROD_PUBLIC_KEY=""
# Webhook secret dla /api/hotels/payment-webhook (opcjonalne, post-MVP).
LITEAPI_WEBHOOK_SECRET=""
# Tryb LiteAPI. MUSI być "production" aby działał booking flow — przy braku tej
# zmiennej klucz prywatny rozwiązuje się do klucza sandboxowego i booking-host
# zwraca 401 (BOOKING_AUDIT.md §2 / BOOKING_BLOCKERS.md B1). Wartości:
# sandbox | production.
LITEAPI_ENV="production"
# LiteAPI Payment SDK environment flag (client-side, widget config).
# Per LiteAPI support: must be exactly "production" or "sandbox".
# Maps to widget config publicKey: "live" or "sandbox".
NEXT_PUBLIC_LITEAPI_ENV=production
# Legacy: jeśli ustawione, fallback gdy brak SANDBOX/PROD.
LITEAPI_API_KEY=""

# --- Booking flow (LiteAPI Payments) -----------------------------------------
# Feature flag bramkujący CAŁY przepływ rezerwacji/płatności. Domyślnie
# "disabled" — przycisk rezerwacji pokazuje stan "Wkrótce dostępne" zamiast
# wołać LiteAPI. Przełącz na "live" dopiero po Phase 4 (test e2e na realnej
# karcie). Wartości: disabled | live.
BOOKING_FLOW_MODE="disabled"

# --- Kill-switch LOTÓW -------------------------------------------------------
# Odpowiednik BOOKING_FLOW_MODE dla ścieżki lotniczej. Domyślnie "disabled".
#
# WYŁĄCZA (granica pieniędzy): POST /api/flights/prebook (503, zanim powstanie
# lock taryfy i PaymentIntent), `payable` w GET /api/flights/session/[id]
# (widget się nie zamontuje) oraz CTA na /loty/wyniki.
#
# NIE WYŁĄCZA — świadomie: /api/flights/book, strony powrotu z płatności,
# webhooka lotów, GET /api/flights/booking/[id] ani stron potwierdzenia.
# Człowiek, który już zapłacił, MUSI dostać swoją rezerwację; hamulec zatrzymuje
# napływ nowych transakcji, nie dokończenie rozpoczętych.
#
# Awaryjne wyłączenie na produkcji: ustaw "disabled" (albo usuń) → redeploy.
# Wartości: disabled | live.
FLIGHTS_FLOW_MODE="disabled"

# --- Furtka testowa (NIE ustawiać na produkcji ani lokalnie) ------------------
# Bezpiecznik `src/lib/testing/production-guard.ts` blokuje testom połączenie z
# produkcyjnym Upstash i niezamockowane zapisy do LiteAPI. Ta zmienna go
# wyłącza — istnieje wyłącznie po to, żeby nikt nie musiał usuwać bezpiecznika.
# ALLOW_PROD_STORE_IN_TESTS="yes-i-know-what-i-am-doing"

# --- Anthropic (Discovery Planner — Phase 6) ---------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
DISCOVERY_LLM_DAILY_CAP="50"

# --- Email (Resend) ----------------------------------------------------------
# Used by src/lib/email/* to send transactional emails (booking confirmations).
# WITHOUT a key set, the booking flow still works — emails are simply skipped
# and a `[email][booking-confirmation] skipped — RESEND_API_KEY not set` line
# is logged once per process.
#
# Get a key: https://resend.com → Sign up → API Keys → Create.
RESEND_API_KEY=""
#
# EMAIL_FROM — sender address. REQUIRED IN PRODUCTION.
#
# INCYDENT 2026-08-28 (booking 9c-OQvmqJ): this used to fall back to Resend's
# testing sender `onboarding@resend.dev`. That domain delivers ONLY to the
# Resend account owner's own address and answers HTTP 403 for everyone else —
# so a real paying customer never received their confirmation. The fallback is
# gone: with EMAIL_FROM unset, production skips the send and logs a warning
# instead of silently failing.
#
# To set it up:
#   1. Add your domain in Resend → Domains → Add (e.g. mail.helptravel.pl).
#   2. Add the listed SPF / DKIM / DMARC DNS records at your DNS provider.
#   3. Wait for "Verified" status (usually < 15 min).
#   4. Then set EMAIL_FROM here. You can pass either:
#        "rezerwacje@mail.helptravel.pl"              ← auto-wraps as "HelpTravel.pl <…>"
#        "HelpTravel.pl <rezerwacje@mail.helptravel.pl>"  ← full form
EMAIL_FROM=""
#
# EMAIL_DEV_FALLBACK — set to "1" ONLY on a local/preview machine to allow the
# `onboarding@resend.dev` testing sender. Ignored on production (VERCEL_ENV or
# NODE_ENV = production), where it can never re-enable that sender.
EMAIL_DEV_FALLBACK=""
#
# EMAIL_REPLY_TO — where replies land. Set this to a real, monitored inbox
# (e.g. kontakt@helptravel.pl) so customers can simply hit Reply.
EMAIL_REPLY_TO=""
#
# EMAIL_BCC — optional ops/audit copy. Set to an internal address to receive
# a BCC of every confirmation (useful for the first weeks of traffic to spot-
# check formatting + deliverability). Leave empty to disable.
EMAIL_BCC=""

# --- PII encryption (Phase 4 — NOT IMPLEMENTED YET) --------------------------
# Reserved for a future phase where guest data is persisted to Postgres. As of
# 2026-05-26 ALL booking PII (name/email/phone of holder + guests) lives only
# in Upstash Redis with a 24-hour TTL — see src/lib/booking/session.ts. The
# `PII_ENCRYPTION_KEY` variable is NOT read anywhere in src/ today. Do not
# set it expecting encryption to "just work" — there is no implementation.
# When/if we move guest data to Postgres, this comment will be removed and
# the variable wired into src/lib/crypto/* before persistence is enabled.
# PII_ENCRYPTION_KEY=""

# --- Admin panel auth --------------------------------------------------------
# Long random string (≥32 ASCII chars). HTTP Basic Auth gate on /admin/* —
# user "admin" + this value as password. Set in Vercel Production env. If
# unset, /admin/* fails closed (503).
ADMIN_SECRET=""

# --- Critical-event alerting (Slack/Discord webhook) -------------------------
# When set, [CRITICAL] events from src/lib/alerting/notify.ts are POSTed here.
# Slack incoming-webhook URLs and Discord webhook URLs are both auto-detected.
# If unset, alerts only land in Vercel function logs.
ALERT_WEBHOOK_URL=""

# --- Operator identification (RODO art. 5 ust. 1 UoŚUDE) ---------------------
# Used by /regulamin and /polityka-prywatnosci § 2 to fill the operator
# identification card. Without these, the pages show "udostępniane na żądanie"
# which is legally OK but less complete. Set all of these in Vercel Production.
# NEXT_PUBLIC_OPERATOR_NAME=""
# NEXT_PUBLIC_OPERATOR_LEGAL_FORM=""
# NEXT_PUBLIC_OPERATOR_ADDRESS=""
# NEXT_PUBLIC_OPERATOR_NIP=""
# NEXT_PUBLIC_OPERATOR_REGON=""
# NEXT_PUBLIC_OPERATOR_REGISTRY=""
# NEXT_PUBLIC_CONTACT_EMAIL=""

# --- Observability (Phase 8) -------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"

# --- Cron (Phase 5 — abandoned cart, pre-stay reminders) ---------------------
CRON_SECRET=""
