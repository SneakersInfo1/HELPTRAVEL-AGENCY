# =============================================================================
# HelpTravel — przykładowy plik środowiskowy
# Skopiuj ten plik jako `.env.local` i wypełnij wartości do pracy lokalnej.
# Na Vercelu: Project Settings → Environment Variables → dodaj każdą osobno.
# =============================================================================

# --- Podstawowe ---------------------------------------------------------------
DATABASE_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# --- Panel admina (/admin/*) --------------------------------------------------
# Basic Auth na całym /admin/*. Bez tych dwóch zmiennych panel będzie zablokowany.
ADMIN_USER=""
ADMIN_PASSWORD=""

# --- Rate limiting (Upstash Redis) -------------------------------------------
# Klucze z https://console.upstash.com/. Jeśli puste, rate limiting WYŁĄCZONY.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Integracje publiczne ----------------------------------------------------
PEXELS_API_KEY=""
GEOAPIFY_API_KEY=""

# --- Travelpayouts (Aviasales — FLIGHTS ONLY) --------------------------------
# Marker dla Aviasales (jedynego ocalałego programu Travelpayouts).
# Hotelowe programy Travelpayouts są wycofane (Hotellook zamknięty 2025-10-20).
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=""
# Token API do Travelpayouts Flight Data (cache cen lotów Aviasales).
TRAVELPAYOUTS_API_TOKEN=""
# Domyślne lotnisko/miasto wylotu (UI fallback).
NEXT_PUBLIC_DEFAULT_ORIGIN_IATA="WAW"
NEXT_PUBLIC_DEFAULT_ORIGIN_CITY="Warszawa"

# --- LiteAPI (HOTELS — sandbox + production) ---------------------------------
# Sandbox (Phase 1+): wymagane do uruchomienia /api/stays/search i Phase 2 UX.
LITEAPI_SANDBOX_KEY=""
LITEAPI_SANDBOX_PRIVATE_KEY=""
# Production (Phase 9): włączamy dopiero po aktywacji LiteAPI Payments.
LITEAPI_PROD_KEY=""
LITEAPI_PROD_PRIVATE_KEY=""
# Webhook secret dla /api/hotels/payment-webhook (Phase 4 kickoff).
LITEAPI_WEBHOOK_SECRET=""
# Środowisko wykorzystywane przez klient LiteAPI (sandbox|production).
LITEAPI_ENV="sandbox"
# Legacy (faza 0/1): jeśli ustawione, używane jako fallback gdy brak SANDBOX/PROD.
LITEAPI_API_KEY=""

# --- Anthropic (Discovery Planner — Phase 6) ---------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
DISCOVERY_LLM_DAILY_CAP="50"

# --- Email (Resend — Phase 5) ------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="rezerwacje@helptravel.pl"
EMAIL_REPLY_TO="pomoc@helptravel.pl"

# --- PII encryption (Phase 4 — booking persistence) --------------------------
# 32-byte klucz w base64; używany do szyfrowania danych gościa w Postgres.
PII_ENCRYPTION_KEY=""

# --- Observability (Phase 8) -------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"

# --- Cron (Phase 5 — abandoned cart, pre-stay reminders) ---------------------
CRON_SECRET=""
