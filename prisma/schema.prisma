generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Foreign-key columns are NOT auto-indexed by Postgres. Every `findMany`
// filtered by sessionId / tripRequestId / destinationId would otherwise do a
// sequential scan. Indexes added 2026-05-26 (post-launch audit). All FK +
// frequently-filtered columns are now covered.
//
// After pulling this PR run:
//   pnpm dlx prisma migrate dev --name add_fk_indexes
// and commit the generated prisma/migrations/<ts>_add_fk_indexes/ folder.
// Vercel does NOT run `prisma migrate deploy` automatically — either add
// `prisma migrate deploy` to the build command or run it manually:
//   vercel env pull && pnpm dlx prisma migrate deploy

model AnonymousSession {
  id         String   @id
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  tripRequests    TripRequest[]
  savedTrips      SavedTrip[]
  affiliateClicks AffiliateClick[]
  events          Event[]

  @@index([createdAt])
  @@index([lastSeenAt])
}

model TripRequest {
  id                  String   @id
  sessionId           String
  mode                String
  rawQuery            String
  normalizedPrefsJson Json
  createdAt           DateTime @default(now())

  session           AnonymousSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  destinationScores DestinationScore[]
  itineraryResults  ItineraryResult[]

  @@index([sessionId])
  @@index([createdAt])
  @@index([mode])
}

model Destination {
  id                       String   @id
  slug                     String   @unique
  city                     String
  country                  String
  visaForPL                Boolean
  avgTempByMonthJson       Json
  costIndex                Float
  beachScore               Float
  cityScore                Float
  sightseeingScore         Float
  nightlifeScore           Float
  natureScore              Float
  safetyScore              Float
  accessScore              Float
  typicalFlightHoursFromPL Float
  affiliateLinksJson       Json

  destinationScores DestinationScore[]
  itineraryResults  ItineraryResult[]

  @@index([country])
  @@index([visaForPL])
}

model DestinationScore {
  id            String @id
  tripRequestId String
  destinationId String
  totalScore    Float
  breakdownJson Json
  reasonsJson   Json
  rank          Int

  tripRequest TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([tripRequestId])
  @@index([destinationId])
  @@index([tripRequestId, rank])
}

model ItineraryResult {
  id                 String @id
  tripRequestId      String
  destinationId      String
  estimatedBudgetMin Int
  estimatedBudgetMax Int
  aiSummary          String
  aiPlanJson         Json

  tripRequest     TripRequest      @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)
  destination     Destination      @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  savedTrips      SavedTrip[]
  affiliateClicks AffiliateClick[]

  @@index([tripRequestId])
  @@index([destinationId])
}

model SavedTrip {
  id                String   @id
  sessionId         String
  itineraryResultId String
  snapshotJson      Json?
  createdAt         DateTime @default(now())

  session         AnonymousSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itineraryResult ItineraryResult  @relation(fields: [itineraryResultId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([itineraryResultId])
  @@index([sessionId, createdAt])
}

model AffiliateClick {
  id                String   @id
  sessionId         String
  itineraryResultId String?
  provider          String
  targetUrl         String
  contextJson       Json?
  createdAt         DateTime @default(now())

  session         AnonymousSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itineraryResult ItineraryResult? @relation(fields: [itineraryResultId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([itineraryResultId])
  @@index([provider])
  @@index([createdAt])
}

// ── Pakiety Lot + Hotel: saga rezerwacji (Faza 2, spec §3.4) ────────────────
// Stan sagi w Postgresie (nie in-memory, nie tylko Redis). Optimistic lock na
// stateVersion — webhook i polling piszą przez jeden serializowany handler
// (src/modules/packages/saga/orchestrator.ts). Deploy migracji = bramka
// właściciela (DATABASE_URL na Vercel PROD + `prisma migrate deploy`).

enum PackageSagaState {
  DRAFT
  FLIGHT_HELD
  HOTEL_PREBOOKED
  HOTEL_PAID
  HOTEL_BOOKED_AWAITING_FLIGHT
  FLIGHT_PAID
  FLIGHT_BOOKED
  CONFIRMED
  CANCELLED
  COMPENSATING
  REFUNDED
  NEEDS_MANUAL_ACTION
}

model PackageBooking {
  id           String           @id
  sagaState    PackageSagaState @default(DRAFT)
  stateVersion Int              @default(0)

  flightPrebookId String?
  flightBookingId String?
  hotelPrebookId  String?
  hotelBookingId  String?
  txnHotel        String?
  // AKTUALNY transactionId lotu (B'); historia podmian po attach services
  // w txnFlightHistoryJson — stary intent jest martwy po każdym attach.
  txnFlight            String?
  txnFlightHistoryJson Json?

  prebookExpiresAt DateTime?
  deadlineAt       DateTime?
  failureReason    String?
  stateLogJson        Json?
  compensationLogJson Json?

  // Kontekst oferty (podsumowanie do maili / confirmation page) + kwoty
  // w minor units (grosze) — jak w warstwie hotelowej, nigdy float.
  offerJson         Json?
  contactEmail      String?
  amountHotelMinor  Int?
  amountFlightMinor Int?
  currency          String @default("PLN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sweep crona deadline'ów: WHERE sagaState = 'HOTEL_BOOKED_AWAITING_FLIGHT'
  // AND deadlineAt <= now() — composite pokrywa oba warunki.
  @@index([sagaState, deadlineAt])
  @@index([createdAt])
}

model Event {
  id          String   @id
  sessionId   String
  eventType   String
  payloadJson Json
  createdAt   DateTime @default(now())

  session AnonymousSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
  @@index([eventType, createdAt])
}
